# Copy this file to .env locally. Never commit the real .env file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wingsbucha_db?schema=public"
ADMIN_PASSWORD="change-this-password"
ADMIN_SESSION_SECRET="change-this-long-random-secret"

# Optional. If empty, uploaded images are saved to public/uploads.
UPLOAD_DIR="public/uploads"
PUBLIC_UPLOAD_BASE_URL="/uploads"

# Optional server settings.
NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"

# CRM integration (server-side only, never prefix with VITE_). Leave CRM_API_URL empty to disable; token is optional.
CRM_API_URL=""
